# Use the direct, non-pooler Neon URL while LiteLLM runs schema migrations.
DATABASE_URL='postgresql://ROLE:PASSWORD@ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require'

# Generated and refreshed by refresh_runtime_env.py.
LITELLM_MASTER_KEY='sk-REPLACE_WITH_A_LONG_RANDOM_VALUE'
LITELLM_SALT_KEY='sk-REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE'
FOUNDRY_MAIN_AGENT_BASE_URL='https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT/agents/MAIN_AGENT/endpoint/protocols/openai'
FOUNDRY_SENTINEL_AGENT_BASE_URL='https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT/agents/SENTINEL_AGENT/endpoint/protocols/openai'
AZURE_AD_TOKEN='REPLACE_WITH_A_CURRENT_ENTRA_TOKEN'
AZURE_AD_TOKEN_EXPIRES_ON='1970-01-01T00:00:00+00:00'

# Optional host binding overrides.
LITELLM_BIND_ADDRESS='127.0.0.1'
LITELLM_PORT='4000'
