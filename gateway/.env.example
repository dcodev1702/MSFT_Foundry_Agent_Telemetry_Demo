# Use the direct, non-pooler Neon URL while LiteLLM runs schema migrations.
DATABASE_URL='postgresql://ROLE:PASSWORD@ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require'

# Generated and refreshed by refresh_runtime_env.py.
LITELLM_MASTER_KEY='sk-REPLACE_WITH_A_LONG_RANDOM_VALUE'
LITELLM_SALT_KEY='sk-REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE'
FOUNDRY_MAIN_AGENT_BASE_URL='https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT/agents/MAIN_AGENT/endpoint/protocols/openai'
FOUNDRY_SENTINEL_AGENT_BASE_URL='https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT/agents/SENTINEL_AGENT/endpoint/protocols/openai'
APPLICATIONINSIGHTS_CONNECTION_STRING='InstrumentationKey=REPLACE_WITH_PROJECT_CONNECTED_APP_INSIGHTS;IngestionEndpoint=https://REGION.in.applicationinsights.azure.com/'
AZURE_AD_TOKEN='REPLACE_WITH_A_CURRENT_ENTRA_TOKEN'
AZURE_AD_TOKEN_EXPIRES_ON='1970-01-01T00:00:00+00:00'
FOUNDRY_MODEL_DEPLOYMENT='MODEL_DEPLOYMENT_NAME'
# LiteLLM internal user and end user, read from the signed-in Azure CLI account and kept once set.
LITELLM_USER_ID='user@example.com'
LITELLM_USER_EMAIL='user@example.com'
LITELLM_END_USER_ID='user@example.com'

# Written by provision_identity.py: the notebook's LiteLLM virtual key.
LITELLM_NOTEBOOK_KEY='sk-REPLACE_WITH_THE_PROVISIONED_VIRTUAL_KEY'

# Optional host binding overrides.
LITELLM_BIND_ADDRESS='127.0.0.1'
LITELLM_PORT='4000'
# Optional: deployment.environment on LiteLLM's spans (compose.yaml defaults to demo).
# OTEL_ENVIRONMENT_NAME='demo'

# Optional and hand-added: a Neon API key for project operations. start.sh keeps
# unmanaged keys like this one; the containers do not receive it.
# NEON_API_KEY='napi_REPLACE_WITH_A_NEON_API_KEY'
